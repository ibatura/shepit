{
  "engines": {
    "dictation": { "engine": "whispercpp", "model": "large-v3-turbo" },
    "preview": { "engine": "whispercpp", "model": "large-v3-turbo" },
    "meetings": { "engine": "whispercpp", "model": "large-v3-turbo" }
  },
  "launchAtLogin": true,
  "typingSpeedWpm": 40,
  "collectStats": true,
  "mode": "toggle",
  "hotkey": { "mods": ["alt"], "key": "space" },
  "cancelKey": "escape",
  "model": "large-v3",
  "language": "uk",
  "stylePrompt": "Сьогодні я відкрив pull request у GitHub, задеплоїв сервіс у Kubernetes і оновив README.",
  "refocusOriginalApp": true,
  "restoreClipboard": true,
  "sounds": true,
  "maxRecordingSeconds": 300,
  "serverPort": 8178,
  "idleUnloadMinutes": 0,
  "overlay": true,
  "livePreview": true,
  "previewModel": "large-v3-turbo",
  "historyMenuItems": 10,
  "addWordHotkey": { "mods": ["ctrl", "alt"], "key": "d" },
  "microphone": "",
  "saveHistory": true,
  "historyDays": 0,
  "failedAudioHours": 24,
  "meetingsFolder": "~/.local/share/dictation/meetings",
  "meetingFileName": "{date} {time} {title}",
  "meetingAskTitle": true,
  "meetingMyName": "",
  "meetingLanguage": "auto",
  "overlayStyle": {
    "position": "bottom",
    "width": 560,
    "opacity": 0.88,
    "backgroundColor": "#141414",
    "textColor": "#FFFFFF",
    "fontSize": 14,
    "listeningText": "Слухаю",
    "transcribingText": "Розпізнаю…",
    "doneText": "Готово",
    "showTimer": true,
    "showMeter": true,
    "meterColor": "#FF4D4D",
    "bars": 10,
    "doneSeconds": 1.0,
    "messageSeconds": 2.5
  }
}
